# Penpot — design/prototyping, Figma alternative (frontend+backend+exporter+Postgres+Redis ≈ 1–2 GB).
# Upstream:
#   git clone https://github.com/penpot/penpot tools/penpot/upstream
#   cd tools/penpot/upstream/docker/images && docker compose -p penpot up -d
# Config via their docker/images/config.env — fill from below.
PENPOT_PUBLIC_URI=https://design.<FILL_IN: your-domain>
PENPOT_SECRET_KEY=<FILL_IN: openssl rand -base64 48>
# Disable open registration after creating your account:
PENPOT_FLAGS=disable-registration enable-login-with-password
