# AppFlowy Cloud — collaborative workspace, Notion alternative (multi-service ≈ 1–2 GB).
# Upstream:
#   git clone https://github.com/AppFlowy-IO/AppFlowy-Cloud tools/appflowy/upstream
#   cd tools/appflowy/upstream && cp deploy.env .env  # fill from below
#   docker compose up -d
FQDN=workspace.<FILL_IN: your-domain>
SCHEME=https
GOTRUE_JWT_SECRET=<FILL_IN: openssl rand -base64 48>
POSTGRES_PASSWORD=<FILL_IN: openssl rand -base64 24>
# Also set SMTP + (optional) OAuth in deploy.env for invites/login.
