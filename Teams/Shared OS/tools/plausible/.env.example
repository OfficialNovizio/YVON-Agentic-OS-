# Plausible CE — privacy analytics (app + Postgres + ClickHouse ≈ 1–2 GB RAM).
# Upstream compose (don't hand-reconstruct — use theirs):
#   git clone https://github.com/plausible/community-edition tools/plausible/upstream
#   cd tools/plausible/upstream && cp .env.example .env  # then fill from below
#   docker compose up -d
BASE_URL=https://analytics.<FILL_IN: your-domain>
# openssl rand -base64 64
SECRET_KEY_BASE=<FILL_IN: openssl rand -base64 64>
# TLS: front with nginx/caddy. Do NOT expose Postgres/ClickHouse ports publicly.
