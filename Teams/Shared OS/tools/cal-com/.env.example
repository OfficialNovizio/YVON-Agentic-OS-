# Cal.com / Cal.diy — scheduling (app + Postgres ≈ 1 GB RAM).
# Likely ran on Hostinger (handout V3) — provision here to restore it.
# Upstream:
#   git clone https://github.com/calcom/cal.diy tools/cal-com/upstream
#   cd tools/cal-com/upstream && cp .env.example .env  # fill from below
#   docker compose up -d
NEXT_PUBLIC_WEBAPP_URL=https://cal.<FILL_IN: your-domain>
# openssl rand -base64 32   (both secrets, generate separately)
NEXTAUTH_SECRET=<FILL_IN: openssl rand -base64 32>
CALENDSO_ENCRYPTION_KEY=<FILL_IN: openssl rand -base64 32>
DATABASE_URL=postgresql://<FILL_IN: user>:<FILL_IN: pass>@database:5432/calcom
