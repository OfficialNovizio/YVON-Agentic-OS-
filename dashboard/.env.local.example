# ─── Supabase (get from your Supabase project → Settings → API) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# ─── LLM providers (optional — screens degrade without them) ─────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ─── Hermes (VPS) — chat + transcribe + hermes-proxy use these ──────────
# HERMES_URL   = https://hermes.yvon.in   (VPS domain; see vps-scripts/MIGRATE-TO-CONTABO.md)
# HERMES_TOKEN = <token printed by vps-scripts/yvon-hermes-http/install.sh>
# VPS_METRICS_URL = https://<metrics-domain>  (ventures-health metrics; omit → offline)

# ─── Vercel sets these automatically in deploy; leave blank locally ──────
# VERCEL_ENV=
