[Unit]
Description=YVON Hermes HTTP wrapper (FastAPI SSE bridge to hermes-agent)
Documentation=file:///opt/yvon-hermes-http/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
WorkingDirectory=/opt/yvon-hermes-http
Environment="HERMES_HOME=/usr/local/lib/hermes-agent"
Environment="YVON_HERMES_TOKEN_PATH=/etc/yvon-hermes/token"
Environment="PYTHONUNBUFFERED=1"
# Use Hermes's own venv — it contains AIAgent + all runtime deps (python-dotenv etc.)
ExecStart=/usr/local/lib/hermes-agent/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8765 \
    --log-level info \
    --no-access-log \
    --timeout-keep-alive 300

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening — the service only needs to read hermes config + write logs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/root/.hermes /var/log /usr/local/lib/hermes-agent/logs
ReadOnlyPaths=/etc/yvon-hermes
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Logs to journald — view with: journalctl -u yvon-hermes-http -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
