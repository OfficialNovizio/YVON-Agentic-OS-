# Dependencies
node_modules
**/node_modules

# Next.js build output
.next
**/.next
.next.buildtest
**/out

# Env / secrets (never commit)
.env
.env*.local
**/.env.local
**/.env*.local

# OS junk
.DS_Store
**/.DS_Store

# Vercel
.vercel

# Scratch / logs / import backups
*.log
**/*.log
**/.import-backup
.import-backup

# TypeScript incremental build cache
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# graphify output (regeneratable via `graphify extract .` + cli/graph-publish.py).
# Commit the small overview (graph-view.json); never the multi-MB raw graph.
graphify-out/
dashboard/public/graph-full.json
dashboard/public/graph.html

# Regenerated by scripts/build-agent-details.mjs + scripts/build-structure.mjs,
# which `dashboard`'s own `dev` and `prebuild` npm scripts already run before
# every dev-server start and every production build — so these are always
# freshly rebuilt from Teams/ at the moment they're actually needed, tracking
# them in git served no purpose. Root cause of "shows modified after every
# commit" (2026-08-21 diagnosis): both scripts stamp `version: Date.now()`
# into their output, so re-running them with IDENTICAL source content still
# produces a byte-different file every time — there was never a real diff to
# review, just a wall-clock stamp churning on every `npm run dev`/build.
dashboard/public/agent-details.json
dashboard/public/structure.json

# Leftover from device_bash's "can't rm on a mounted folder, mv to _to_delete/
# instead" workaround used earlier this session — meant to be deleted by hand
# afterward (device_bash truly cannot delete these), never a real artifact.
# Gitignored so a straggler doesn't need per-commit exclusion, but should
# still be deleted outright — see the assistant's reply for the rm command.
_to_delete/
**/_to_delete/
**/_to_delete_*

# On-demand tool runtime (cli/tool.sh) — commit compose + .env.example only.
# Tool config now lives under Teams/Shared OS/tools/<name>/; secrets/data/clones never do.
Teams/Shared OS/tools/**/.env
Teams/Shared OS/tools/**/data/
Teams/Shared OS/tools/**/.data/
Teams/Shared OS/tools/**/upstream/

# Python bytecode — runtime noise, never commit
__pycache__/
*.pyc

# graphify local worktree/branch state — machine-specific (absolute paths,
# session timestamps), regenerated automatically, never portable across machines
.graphify/

# Transient pending PRDs (docs/PRD-prd-gated-task-conversion.md) — deleted on
# convert/discard, never a real governed record; nothing here should be committed.
store/tasks/.pending/

# Design-first workflow session state (docs/PRD-design-first-workflow.md) —
# ephemeral pre-PRD records + working design.md/handoff.md files, same
# discipline as store/tasks/.pending/: nothing here is a governed record.
# pricing.example.json (the tracked template) and README.md are exempted below.
store/design-sessions/*.json
store/design-sessions/*-design.md
store/design-sessions/*-handoff.md
!store/design-sessions/pricing.example.json
!store/design-sessions/curated-references.json
!store/design-sessions/README.md

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
